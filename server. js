app.put(
  '/api/admin/content/:id',
  auth,
  adminOnly,
  async (req, res) => {
    try {
      const {
        title,
        slug,
        excerpt,
        body,
        cover_image,
        section_id,
        content_type,
        status
      } = req.body;

      const result = await pool.query(
        `
        UPDATE contents
        SET
          title = COALESCE($1,title),
          slug = COALESCE($2,slug),
          excerpt = COALESCE($3,excerpt),
          body = COALESCE($4,body),
          cover_image = COALESCE($5,cover_image),
          section_id = COALESCE($6,section_id),
          content_type = COALESCE($7,content_type),
          status = COALESCE($8,status),
          updated_at = NOW(),
          published_at =
            CASE
              WHEN $8 = 'published'
              THEN COALESCE(published_at,NOW())
              ELSE published_at
            END
        WHERE id = $9
        RETURNING *
        `,
        [
          title,
          slug,
          excerpt,
          body,
          cover_image,
          section_id,
          content_type,
          status,
          req.params.id
        ]
      );

      if (result.rowCount === 0) {
        return res.status(404).json({
          success: false,
          message: 'Content not found'
        });
      }

      res.json({
        success: true,
        content: result.rows[0]
      });
    } catch {
      res.status(500).json({
