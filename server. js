        });
      }

      const result = await pool.query(
        `
        INSERT INTO schedules
        (id,content_id,scheduled_at)
        VALUES ($1,$2,$3)
        RETURNING *
        `,
        [
          uuid(),
          content_id,
          scheduled_at
        ]
      );

      res.status(201).json({
        success: true,
        schedule: result.rows[0]
      });
    } catch {
      res.status(500).json({
        success: false,
        message: 'Unable to schedule content'
      });
    }
  }
);

/* =========================================================
   AUTOMATION ENGINE
========================================================= */

async function runAutomation() {
  if (!pool) return;

  const runId = uuid();

  try {
    await pool.query(
      `
      INSERT INTO automation_runs
      (id,type,status,message)
      VALUES ($1,$2,$3,$4)
      `,
      [
        runId,
        'scheduled-publishing',
        'running',
        'Automation started'
      ]
    );

    const schedules = await pool.query(`
      SELECT *
      FROM schedules
      WHERE status = 'pending'
      AND scheduled_at <= NOW()
      ORDER BY scheduled_at ASC
      LIMIT 50
    `);

    for (const schedule of schedules.rows) {
      await pool.query(
        `
        UPDATE contents
        SET
          status = 'published',
          published_at = COALESCE(published_at,NOW()),
          updated_at = NOW()
        WHERE id = $1
        `,
        [schedule.content_id]
      );

      await pool.query(
        `
        UPDATE schedules
        SET status = 'completed'
        WHERE id = $1
        `,
        [schedule.id]
      );
    }

    await pool.query(
      `
      UPDATE automation_runs
      SET
        status = 'completed',
        message = $1,
        finished_at = NOW()
      WHERE id = $2
      `,
      [
        `Published ${schedules.rowCount} scheduled item(s)`,
        runId
      ]
    );
  } catch (error) {
    console.error('AUTOMATION ERROR:', error);

    await pool.query(
      `
      UPDATE automation_runs
      SET
        status = 'failed',
        message = $1,
        finished_at = NOW()
      WHERE id = $2
      `,
      [
        error.message,
        runId
      ]
    ).catch(() => {});
  }
}

